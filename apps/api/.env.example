# Which model drives "Ask": anthropic | openai_compatible | fake
BEZE_AI_PROVIDER=fake
BEZE_AI_MODEL=claude-opus-5-5
BEZE_AI_EFFORT=medium

# anthropic: set ANTHROPIC_API_KEY (or log in with `ant auth login`)
# ANTHROPIC_API_KEY=

# openai_compatible: a vLLM / Ollama / LM Studio server on your GPUs, e.g.
#   vllm serve Qwen/Qwen3-32B --enable-auto-tool-choice --tool-call-parser hermes
# BEZE_AI_PROVIDER=openai_compatible
# BEZE_AI_MODEL=Qwen/Qwen3-32B
# BEZE_OPENAI_BASE_URL=http://gpu-box:8000/v1
# BEZE_OPENAI_API_KEY=not-needed
